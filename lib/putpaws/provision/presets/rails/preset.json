{
  "defaults": {
    "cpu_architecture": "ARM64",
    "cpu": "256",
    "memory": "512",
    "desired_count": 1,
    "container_port": 8080,
    "log_retention_days": 30,
    "image_tag": "latest",
    "assign_public_ip": "DISABLED",
    "env": {
      "RAILS_ENV": "production",
      "RACK_ENV": "production",
      "RAILS_LOG_TO_STDOUT": "1",
      "HTTP_PORT": "8080"
    },
    "secrets": {
      "RAILS_MASTER_KEY": "{ssm_parameter_prefix}/RAILS_MASTER_KEY"
    }
  },
  "task_definitions": [
    { "suffix": "app", "template": "taskdef-app.json.erb", "container_name": "app" }
  ],
  "service_task_definition": "app",
  "devops_defaults": {
    "source_type": "GITHUB",
    "environment_images": {
      "ARM64": "aws/codebuild/amazonlinux-aarch64-standard:3.0",
      "X86_64": "aws/codebuild/standard:7.0"
    },
    "compute_type": "BUILD_GENERAL1_SMALL",
    "privileged_mode": true,
    "buildspec": "buildspec.yml"
  }
}
